# ---- Core ----
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Database ----
# SQLite (default, zero-config, works out of the box for dev/demo)
DATABASE_URL=sqlite:///./trafficai.db
# For production, point to Postgres instead, e.g.:
# DATABASE_URL=postgresql+psycopg2://urbanguard:urbanguard@postgres:5432/urbanguard

# ---- Cache (optional, app degrades gracefully if unavailable) ----
REDIS_URL=redis://redis:6379/0

# ---- AI Assistant (optional cloud fallback; local rule-based engine works with no key) ----
GEMINI_API_KEY=

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# ---- IoT ingestion ----
# If set, POST /api/v1/sensors/ingest requires a matching X-Device-Key
# header from every physical sensor/gateway. Leave blank for local
# demo/testing; set a real value before exposing this endpoint publicly.
IOT_DEVICE_KEY=
